precision highp float;

out vec4 outColor;

uniform vec2  uResolution;
uniform float uTime;
uniform vec3  uSunDir;
uniform vec3  uMoonDir;
uniform vec2  uCam;          // x = 方位角, y = 俯仰角（弧度）
uniform float uTanHalfFov;
uniform float uExposure;
uniform float uGain;         // 自动曝光增益

uniform float uDepth;        // 相机深度（米，水面之下）
uniform float uFloorDrop;    // 沙面在相机**下方**多少米；0 表示没有底（深水主题）
uniform vec3  uBeamDir;      // 直射光在水里传播的方向（已折射，y < 0）
uniform vec3  uAmbDir;       // 漫射天光在水里的方向（已折射，y < 0）
uniform vec3  uBeamTint;     // 水面之上那个光源的色相
uniform float uBeamPower;
uniform float uAmbPower;
uniform vec3  uAbsorb;       // 总消光 = 吸收 + 散射（1/m）
uniform vec3  uScatterNorm;  // σs/σt 按亮度归一后的谱形（常量，CPU 侧算好，见 sky.ts）
uniform float uPhaseG;       // Henyey-Greenstein 不对称因子
uniform vec3  uScatterTint;  // 水体底光的颜色
uniform float uCaustic;      // 水面波纹的强度
uniform float uSurfaceGlow;  // 水面下方那层波光的强度
uniform vec3  uSkyAbove;     // 透过 Snell 窗看到的天
uniform sampler2D uOcean;    // FFT 波场：R 空置 · G ∂h/∂x · B ∂h/∂z · A 焦散
uniform float uInvPatch;     // 1 / 波场物理边长（米）。取样是热点路径，除法在这里预先做掉

/* 这里刻意没有任何全局角度常量：需要 2π 的地方（涟漪的相位）用的是各自的角频率常数。 */

/*
 * Snell 窗。从水下抬头，只有离垂直方向 48.6° 以内能看到水面之上的天；
 * 再往外水面就是一面镜子（全反射），映的是水里的暗。
 * 这个角是算出来的，不是调的：asin(1 / 1.333) = 48.6°。
 * 它是「水下面」最有力的一个暗示 —— 抬头只有一个亮窗，四周全是暗的。
 *
 * 边界不在这里判：surfaceAt 把视线对**逐点波面法线**做 refract，
 * 全反射由折射率自己决定，窗边因此是碎的（原来拿视线 y 和常数比大小，
 * 窗边是一条解析圆弧，画面上像撕开的纸）。
 */
const float N_WATER = 1.333;

/*
 * 步进。水的吸收是纯指数，所以几何步长天然匹配：近处密（结构最细、光最亮），
 * 远处疏（那里只剩一片被水吃干净的蓝）。累计扫过的距离远超蓝光的有效射程，
 * 再远没有信息，多走一步都是浪费。
 */
const int   STEPS = 18;
const float STEP0 = 0.30;
const float STEP_GROWTH = 1.40;

/**
 * `SCATTER`（散射系数，1/m）**已随直射光柱一起删除**。
 *
 * 它原本是「光柱与底光的强度比」，也就是「光柱能不能被看见」这一个旋钮 ——
 * 值调过 0.065 / 0.19 / 0.10 / 0.14 / 0.12，每一档的取舍都记在旧注释里。
 * 直射光柱那一项删掉之后（理由见 `waterVolume` 的注释），它没有任何使用者了。
 *
 * 水体现在的「厚薄」由 `uAmbPower`（漫射底光的权重）和 `SCAT_LEN`（有效积分长度）决定：
 * 前者决定水自己发多少光，后者决定这份光来自眼前哪几米。**不要再把它加回来** ——
 * 它就是那层把画面糊成横条的东西。
 */

/** 海底白沙的反照率。浅水主题的高调几乎全部来自它 —— 沙把光弹回眼睛里。 */
const vec3 SAND = vec3(0.94, 0.89, 0.78);

/*
 * 焦散与倒影的形状常数。这几个是**搜出来的**，不是手调的：在一份把着色器数学
 * 原样重写一遍的台架上扫参数，让整幅画面的分位数落在能撑住正文对比度的窗口里，
 * 同时要求每一横行的横向色差够大（否则远看就是一块没有信息的渐变）。
 *
 * 「聚焦只重新分配光、不凭空造光」这条**不需要常数去保证**：焦散的均值由 GPU
 * 回读**实测标定**成 1（见 ocean.ts），它是量出来的。
 */
/**
 * 沙面上那张网要推到很亮才有「碎金」感；镜面里的网只是暗处的一点花纹。
 *
 * 光网的分布是对数正态的（中位数 1，长尾能到 20 倍以上），所以这个增益稍给大一点，
 * 相机脚下那几米的亮部就会直接顶穿 ACES，沙子的暖色和纹路全被吃掉，只剩一条
 * 没有色相的白带。反过来压得太狠又会让沙面太平 —— 浅水照片里最抓眼的东西
 * 就是**沙底上那层会动的水光网**，而网的形状全靠「亮线对暗底」的比值。
 * 所以这个数要和沙面的环境底光一起看：底光高一点，网就糊一点。
 */
const float NET_GAIN = 1.90;
/**
 * 水面倒影的两项。基座是水自己散射回来的光，闪光是被波纹聚焦的直射光。
 *
 * 倒影之所以好看，靠的是**闪光那一项的起伏**，基座只该是一个「暗处的底」——
 * 基座给大了，一大片倒影只剩一个平的青色底，波纹拉出来的花纹全被压在里面。
 *
 * 但也别把它压得太狠：倒影带正好压在正文带里，基座一低，正文带最暗的那一档
 * 就跟着掉，而薄膜是按那一档定 alpha 的 —— 结果是遮罩被推高，把同一带里
 * 占多数的亮窗一起抬成浅灰。**暗部该留在中段，不该侵占要放字的那一带。**
 */
const float MIRROR_BASE = 0.85;
/**
 * 镜面里那层光网的强度（0.85 → 0.45）。
 *
 * 这一条是治「整个右半边是一片放射状的冰针」的。光网在沙面上是主角，
 * 但**在镜面里它是被压扁的**：掠射视线把 xz 平面上的一张网沿视线方向拉长十倍，
 * 几米宽的焦散脊于是变成几十上百像素的长丝。这个增益给大了，这些长丝会亮过镜面底色，
 * 整片镜子就成了从画面上方某一点散开的一把针 —— 加上海水本来偏青，
 * 读起来是云母 / 拉丝冰 / 彗尾，不是水。
 *
 * 物理上这里本来就该弱：镜面反射的是**水面之上**的天光，通过波面折下来的焦散
 * 只是叠加在上面的一层调制，不该压过底色。
 * 沙面那张网走的是另一个常数（NET_GAIN），完全不受这里影响。
 */
const float MIRROR_GLINT = 0.45;

/**
 * 镜子里那片水相对**相机深度**又走过了几倍的路。
 *
 * 掠射视线在水面下看到的确实比相机旁边那层更深，但**深得多不等于暗得多**：
 * 那一段水同时在被光照亮，它的亮度由「散射生成」而不是「透射剩余」决定。
 * 把它当纯透射算会暗得过头。取一个略大于 1 的值：倒影是一块**深青的水**，
 * 和沙面、水体能接上，又不会亮到把中段填平。
 */
const float MIRROR_PATH = 1.4;

/*
 * --- Snell 窗的四个「光源特征」---
 *
 * 删掉直射光柱之后，窗是全画幅唯一的视觉重心。而它若只有「一层均匀的天色 +
 * 一个柔光斑」，读起来像**一块发光的白布**，不像「抬头看水面」—— 真实水下照片里
 * 至少有三样东西：日面周围一大团天空辉光、被波纹撕碎的日面、以及窗沿那圈碎银。
 * 下面四个常数各自管一样。
 */
/**
 * 日晕相对日面的强度与角宽度。宽度不是调的：它是水面斜率抖动把日面那束光
 * 在天空里抹开的量级 —— 点光源经过粗糙界面后剩下的就是这层宽晕。
 * 强度要克制：加到一定程度窗心就会穿过 ACES 肩部，正文带被顶成纯白，
 * 碎丝和光网全部消失。
 */
const float HALO_GAIN = 0.135;
const float HALO_WIDTH = 0.50;
/**
 * 日面被波纹撕碎的程度。乘在日面那一项上，走**均值守住**的写法
 * （`1 + (c−1)·k`，不是 `mix`）—— 焦散场是右偏的，直接减调制会把整片窗抬亮。
 * 上限给「亮线穿过日面」那一下封顶，否则单像素能到好几倍，在窗里点出一把过曝的白点。
 */
const float GLITTER_CONTRAST = 0.55;
const float GLITTER_MAX = 2.6;
/**
 * 窗沿那圈碎银的强度。
 *
 * 物理来源是**辐亮度压缩**：天空被折射挤进 48.6° 这个锥里，越靠近锥边，
 * 单位立体角里塞进去的天空越多，所以窗沿本该是**最亮的一圈**，不是最暗的。
 * 只写「掠射出射的天空本身暗」会漏掉「但被压缩了」，于是窗与镜的交界
 * 成了全画幅最塌的一条沟。
 *
 * 权重用 `4·R·(1−R)`：它在窗 / 镜各半处取极大、两端归零，所以这条亮带
 * **天然落在交界上**，不需要任何几何判据去画它；而 R 是逐像素对波面法线算的，
 * 亮带因此是碎的 —— 这正是「撕开的纸」变成「碎银」的那一步。
 */
const float RING_GAIN = 0.22;
/**
 * 有效散射长度（米）。它既是底光形状因子的归一化长度，也是积分的有效长度。
 *
 * 这个数决定的不只是亮暗：一条掠射视线沿途要穿过好几个波长的波纹场，
 * L 长的时候亮线和暗线在积分里互相抵消，只剩平均值 —— 画面得到一块平滑的色，
 * 纵向什么结构都没有。L 短的时候有效积分长度只剩一两个波长，亮线还是亮线。
 *
 * 物理上这就是「水有多浑」，而丁达尔光柱本来就只出现在浑水里 —— 清水里看不见。
 * 取近岸水华的量级，比远洋浑，也更接近那些参考照片实际拍摄的水体。
 */
const float SCAT_LEN = 3.0;

/*
 * 水面陡度**不是一个常数**：σ 由**谱的归一化**直接给出（ocean.ts 把整份谱缩放到
 * 目标斜率均方根），纹理里的斜率就是物理斜率，这里只管用它。
 *
 * 但几何约束还在，而且是一条可测量的量（回读的 slopeRms 会打出来）：
 * 正文带的入射角离水→空气的临界角只有十几度余量，法线倾角均方根一旦超过它，
 * 正文带里大半像素会被翻到镜面侧，窗就被碎纹切碎、画面上部成一张均匀的中间调。
 */

/* ---------------- 噪声 ---------------- */

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash12(i);
  float b = hash12(i + vec2(1.0, 0.0));
  float c = hash12(i + vec2(0.0, 1.0));
  float d = hash12(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p, int octaves) {
  float sum = 0.0;
  float amp = 0.5;
  for (int i = 0; i < 6; i++) {
    if (i >= octaves) break;
    sum += amp * vnoise(p);
    p = p * 2.03 + vec2(17.3, 9.1);
    amp *= 0.5;
  }
  return sum;
}

/* ---------------- 相机 ---------------- */

vec3 rotateX(vec3 v, float a) {
  float c = cos(a), s = sin(a);
  return vec3(v.x, c * v.y - s * v.z, s * v.y + c * v.z);
}

vec3 rotateY(vec3 v, float a) {
  float c = cos(a), s = sin(a);
  return vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z);
}

vec3 rayDir(vec2 fragCoord) {
  /**
   * uv 减的是**半高**，所以 uv.y 落在 ±0.5；d.z 取 0.5/uTanHalfFov 才让 FOV_Y 是真正的视场角。
   * 这里曾经写成 1.0/uTanHalfFov，等效竖直视场只有一半，画面被悄悄裁成了长焦：
   * 顶上那片「光进来的 Snell 窗」整个跑到画外，海底只剩薄薄一条，
   * 中间一大片全是掠射角拉长的水面倒影 —— 于是怎么调都像一块渐变。
   */
  vec2 uv = (fragCoord - 0.5 * uResolution) / uResolution.y;
  // 世界坐标：X = 东, Y = 天顶, Z = 北
  vec3 d = vec3(uv.x, uv.y, 0.5 / uTanHalfFov);
  d = rotateX(d, -uCam.y);
  d = rotateY(d, uCam.x);
  return normalize(d);
}

/* ---------------- 水面波场（FFT） ----------------
 *
 * 波场纹理是 GPU 上每帧跑一遍 FFT 海面算出来的（见 ocean.ts）：
 * 两个斜率、拉普拉斯**是同一个随机波场的精确导数**，焦散从拉普拉斯直接得出。
 * 早期是若干个固定平面波的叠加，再加一个和波场毫无关系的噪声焦散场 ——
 * 于是画面是一层平行条纹、光网是一团团对不上水面的亮斑。根因就在这里。
 *
 * 纹理通道（见 ocean-resolve.frag.glsl）：
 *   R   空置（原粗带焦散，只服务于已删的直射光柱）
 *   G/B = ∂h/∂x, ∂h/∂z（法线）
 *   A = 全带焦散（给沙面和镜面用）
 *
 * 取样一律传**未取模**的 p（乘 uInvPatch）：纹理开了 RepeatWrapping，硬件会正确地在
 * 接缝处跨边界插值；自己 fract() 反而会在缝上造出一条半纹素的硬边。
 * 距离 LOD 交给 mipmap：硬件按屏幕空间导数自动选级，远处的高频被自然平均掉。
 */

/* 三次 B 样条过滤：4 次双线性取样近似 B 样条。
 *
 * 硬件双线性给出的斜率是**分片线性**的，高光会沿纹素格子出现硬折 ——
 * 在 Snell 窗那种「整片天被折射掰来掰去」的路径上尤其明显。
 * B 样条把插值核换成 C¹ 连续的，斜率处处平滑，高光就变成连续的绸面。
 * 权重是样条基的闭合形式，所以仍然是 4 次取样。
 *
 * **试过删掉它（换纯双线性），量完之后又加回来了**：确定性单帧对照显示
 * 差异就落在 Snell 窗那几条高光脊上 —— 也就是它本来要治的地方。
 */
vec4 texBS4(sampler2D t, vec2 uv) {
  vec2 ts = vec2(textureSize(t, 0));
  vec2 p = uv * ts - 0.5;
  vec2 f = fract(p);
  p = floor(p);
  vec2 f2 = f * f;
  vec2 f3 = f2 * f;
  vec2 w0 = (-f3 + 3.0 * f2 - 3.0 * f + 1.0) / 6.0;
  vec2 w1 = (3.0 * f3 - 6.0 * f2 + 4.0) / 6.0;
  vec2 w2 = (-3.0 * f3 + 3.0 * f2 + 3.0 * f + 1.0) / 6.0;
  vec2 w3 = f3 / 6.0;
  vec2 g0 = w0 + w1;
  vec2 g1 = w2 + w3;
  vec2 h0 = (w1 / g0 - 0.5 + p) / ts;
  vec2 h1 = (w3 / g1 + 1.5 + p) / ts;
  return (texture(t, vec2(h0.x, h0.y)) * g0.x + texture(t, vec2(h1.x, h0.y)) * g1.x) * g0.y
    + (texture(t, vec2(h0.x, h1.y)) * g0.x + texture(t, vec2(h1.x, h1.y)) * g1.x) * g1.y;
}

/* 倍频八度：B 场相对主场旋转 36.87°（3-4-5 直角三角形）、缩到 0.41 倍。
   这套 A/B 两取样的结构和 WB 的权重来自 clearwater。
   第三个「近处细碎」的场被删掉了：它只多一次取样，而那点尺度在低渲染比例下
   本来就在像素以下，单变量对照实测差别远小于一个色阶。 */
const mat2 OCT_M = mat2(0.8, -0.6, 0.6, 0.8);
const float OCT_SC = 0.41;
const float OCT_WB = 0.10;
/** 焦散上限，和 ocean.ts 的 CAUSTIC_MAX 是同一个数（改一边必须改另一边）。 */
const float NET_MAX = 6.0;

/**
 * 波场取样 —— 一次调用给出「海面」而不是「一层网」。返回 vec3(∂h/∂x, ∂h/∂z, 全带焦散)。
 *
 * 主 patch 上再叠一个旋转 36.87°、缩到 0.41 倍的副本。旧版只取一次 A 场：
 * FFT 网格摊在 6m 上，单取样的网眼在 Snell 窗里一格就有几十个像素，
 * 读起来是「一块一块的鼓包」；而真实海面的斜率是跨好几个数量级的自相似场，
 * 一个旋转+缩放的副本叠上去，网眼里才长出次级网眼。
 *
 * 斜率走链式法则：B 场铺在 (patch·SC) 的尺度上、高度权重 WB·SC，
 * 于是它的斜率贡献恰好是 WB·(Mᵀ·∇h_B) —— SC 被铺展的坐标缩放自己约掉了。
 * 焦散通道是**非线性**场（1/|J|），不能这样线性合并，用乘性混合近似：
 * 两个均值 1 的独立场相乘期望仍是 1（守均值），而旋转过的第二张网会织进主网，
 * 把「单向的网」打散。乘完夹回 NET_MAX，防止两条亮线叠出超上限的尖。
 *
 * 距离 LOD 由硬件按屏幕空间导数选级（mipmap + 各向异性），这里不做手写淡出。
 */
vec3 waveField(vec2 p) {
  vec4 A = texBS4(uOcean, p * uInvPatch);
  vec4 B = texBS4(uOcean, (OCT_M * p) * (uInvPatch / OCT_SC) + 0.37);
  vec2 slope = A.yz + OCT_WB * (transpose(OCT_M) * B.yz);
  return vec3(slope, min(A.w * mix(1.0, B.w, OCT_WB), NET_MAX));
}

/** 全带焦散的标量版（seaFloor 只关心它，斜率不参与）。 */
float fineNet(vec2 p) {
  float a = texBS4(uOcean, p * uInvPatch).w;
  float b = texBS4(uOcean, (OCT_M * p) * (uInvPatch / OCT_SC) + 0.37).w;
  return min(a * mix(1.0, b, OCT_WB), NET_MAX);
}

/* **逐波长色散（dispCaustic）已删除。**
 *
 * 它按水对红 / 蓝折射率差给 R/B 通道各偏一个纹素的取样坐标，在沙面的焦散亮线
 * 边缘镶一圈彩虹。代价是每个沙面像素多两次取样，而低渲染比例加 mipmap 之后
 * 那圈彩边本来就落在像素以下 —— 沙面改用标量 fineNet。 */

/* ---------------- 交互涟漪（clearwater 的 tap-to-ripple，解析波包版） ----------------
 *
 * 参考项目跑了一张 256² 的波动方程场（RN / RSIZE，每帧一步 + 边界淡出）。
 * 这里不需要那个量级：点击产生的是一圈**向外跑的环形波**，它有闭式解
 *
 *   h(r,τ) = e^(−r²/2σ²(τ)) · sin(q r − ω τ) · A
 *
 * 斜率和拉普拉斯对 r 求导就是解析式（下面用的是二维极坐标拉普拉斯的完整式，
 * 含 1/r 的环向项），一次 hypot 一个环，最多 8 个环 —— 比再开一条 FFT 链
 * 便宜两个数量级。代价是不反射、不干涉：环与环线性相加，那正是线性波近似。
 */
const int   DROP_MAX = 8;
/* 尺度是**按这台相机的机位**定的，不是照抄参考项目：
   相机在水面下几米，点击点打在十几米外的水面上。半径半米量级的环在那里只有十来个像素
   —— 功能上「有」，画面上看不见。
   所以把包络放大到米级、把空间频率放粗到 1m 上下（再细的环在远处会被 mipmap 平均掉，
   等于白算），并让它多活一会儿。 */
const float DROP_R = 1.1;       // 初始包络 σ（米）
const float DROP_SPREAD = 0.9;  // σ² 随时间的扩散速率（米²/秒）：环往外走的同时明显变宽
const float DROP_TAU = 3.0;     // 时间衰减常数（水面时钟秒）
const float DROP_Q = 5.5;       // 空间频率（rad/m）：波长约 1.14m —— 远处也还看得见
const float DROP_OMEGA = 4.4;   // 角频率（rad/秒）：相速度 ω/q = 0.8 m/s，读得清
/** 环的振幅（米）。斜率 = A·q，要比水面自身的斜率均方根明显大，一眼才认得出。 */
const float DROP_AMP = 0.07;
/**
 * 涟漪焦散的线性化系数。FFT 场那边用的是由 σ_lap 反算出来的 λ_fine，
 * 但涟漪的振幅是直接以米为单位给的，拉普拉斯量级比 FFT 场高得多 ——
 * 用同一个 λ 会把环心推到 clamp 上限。取一个小得多的值，让最亮处和环谷都留在合理区间。
 */
const float DROP_CAUSTIC = 0.35;

uniform int uDropCount;
/* xy = 世界 xz，z = 出生时刻（水面时钟秒），w = **相对**振幅（1 = 标准强度，见下面 DROP_AMP） */
uniform vec4 uDrops[DROP_MAX];

/**
 * 所有涟漪在 p 点的叠加，返回 vec3(∂h/x, ∂h/z, 拉普拉斯)。
 *
 * 焦散走和 FFT 场同一条线性化公式 `1 + λ·(−∇²h)`：拉普拉斯为负（波峰）变暗、
 * 为正（波谷）变亮，环的内外两圈亮暗自然成对 —— 和真实涟漪的聚焦图案一致。
 */
vec3 dropField(vec2 p) {
  vec3 acc = vec3(0.0);
  for (int i = 0; i < DROP_MAX; i++) {
    if (i >= uDropCount)
      break;
    vec4 d = uDrops[i];
    float age = uTime - d.z;
    if (age < 0.0 || age > 3.0 * DROP_TAU)
      continue;
    vec2 dp = p - d.xy;
    float r = length(dp);
    float s2 = DROP_R * DROP_R + DROP_SPREAD * age;   // σ²(τ)
    float decay = exp(-age / DROP_TAU) * d.w;
    if (decay < 1e-4)
      continue;
    // d.w 是「相对振幅」：乘上 DROP_AMP 才是米
    decay *= DROP_AMP;
    float g = exp(-r * r / (2.0 * s2));               // 高斯包络
    float ph = DROP_Q * r - DROP_OMEGA * age;
    float sn = sin(ph);
    float cs = cos(ph);
    // ∇h = g·[−(r/σ²)·sin + q·cos]·(dp/r)
    acc.xy += g * (-r / s2 * sn + DROP_Q * cs) * (dp / max(r, 1e-4)) * decay;
    // ∇²h = g·[(r²/σ⁴ − 2/σ² − q²)·sin + q(1/r − 2r/σ²)·cos]
    acc.z += g * ((r * r / (s2 * s2) - 2.0 / s2 - DROP_Q * DROP_Q) * sn
      + DROP_Q * (1.0 / max(r, 1e-4) - 2.0 * r / s2) * cs) * decay;
  }
  return acc;
}

/* **体积里那套焦散取样（oceanCaustic / CAUSTIC_BLUR / 粗带焦散）已全部删除。**
 *
 * 它原来在体积循环的每一步取一次粗带焦散，给漫射底光加一层调制 —— 目的只有一个：
 * 让**直射光柱**在积分里活下来。直射光柱删掉之后这一项没有任何消费者了，
 * 而它每像素要付十几次纹理取样（一步一次），是整个着色器最贵的一项。
 *
 * 值得记下来的是**它不影响曝光标定**：那一项写的是守均值的写法（期望恒为 1），
 * 所以去掉它前后水体的平均亮度不变 —— 闭环与薄膜的整套校准因此不用重测。 */

/* ---------------- 水体 ---------------- */

/**
 * 水下的单次散射积分。返回累加的散射亮度，marched 是实际推进的距离。
 *
 * 只剩**漫射底光**一项：整个天空是一个面光源，沿 uAmbDir 从水面漏下来。
 * 每一步（位置 p，距相机 t）累加同一束光经过的两次消光：天光从水面走到 p 那一段
 * （按 uAbsorb 的谱衰减），以及沿视线从相机到 p 那一段（exp(−aRef·t)，
 * 把积分限制在相机周围 SCAT_LEN 米之内）。
 *
 * 颜色完全由 CPU 给的 uScatterTint 决定（它就是「相机所在深度看到的水色」），
 * 这里只算一个**标量形状因子**。用标量而不是逐通道衰减是有意的：
 * 取参考散射长度 aRef = 1/SCAT_LEN，半无限积分 ∫exp(−t/L)dt/L 就收敛到 1 ——
 * 相机附近是 1、往深处按深度衰减到 0，深浅两层水的「厚薄」全挂在它身上，
 * 而不是另调一个颜色；同时避免红光早早把整项掐灭。
 *
 * L 同时就是**有效积分长度**：它决定一条掠射视线沿途把水面的结构平均掉多少。
 * L 长（清澈远洋）→ 一片平滑；L 短（近岸浑水）→ 相机附近那十几米说了算。
 * 真实的丁达尔光柱只出现在浑水里，所以这里取的是「近岸」不是「远洋」。
 */
vec3 waterVolume(vec3 dir, float limit, out float marched) {
  /* **直射光柱（beam）已移除**（按用户明确要求）。
   *
   * 它原来是把每一步沿光的来向投影回水面、取那一点的焦散图案累加起来，
   * 想做出「一根一根的丁达尔光柱」。结论是**这个做法在这套构图里不成立**：
   *
   *   1. 焦散是**二维图案**，把它沿视线投影回来得到的是**斑块**，不是柱子。
   *   2. 要让它变成「柱」得让胞元远大于积分长度，于是去加粗带焦散，
   *      结果只是把斑块加粗，同时还把正文带的明暗幅度拉大、逼着薄膜加重。
   *   3. 参考项目里那种硬光柱靠的是**折射网格 + 屏幕空间面积**，不是投影焦散；
   *      而它的相机在水面之上俯视浅池，和这里「水下仰视」是两回事。
   *
   * ⚠ **不要拿「它造成了横向条带」当删除理由 —— 那条证据是错的。**
   * 当时量逐行剖面时只藏了薄膜、**没有藏掉前景**，量到的是钟点、搜索栏和磁贴，
   * 所谓的「条带」其实是搜索栏下边框加磁贴的起伏。藏掉前景再逐行扫，
   * 背景的纵向剖面是一条平滑的渐变，根本没有横向条带。删除本身照样成立
   * （用户要的），但那个理由是量错了对象。
   *
   * --- 底光的两件物理 ---
   *
   *   1. **σs/σt 的谱**（uScatterNorm，CPU 侧算好）：蓝端散射占消光的比远高于红端，
   *      所以水自己发的光比「透过去的水」更蓝 —— 这就是水为什么是蓝的。
   *      按亮度归一后再乘：色相变、亮度不变，闭环与薄膜的整套校准因此不动。
   *   2. **HG 相函数**（dirW）：顺着光看比逆着光看亮。完整 HG 的前后比在 g 取常用值时
   *      高达几十比一，那是「亮包」，正是被删掉的光柱想干的事；压到很弱是「一层方向感」。
   */
  vec3 sumAmb = vec3(0.0);
  float t = 0.0;
  float ds = STEP0;

  // 参考散射长度：整段积分的归一化挂在它身上，同时它就是有效积分长度
  float aRef = 1.0 / SCAT_LEN;

  /* HG 相函数，限幅后归一到均值 1 附近（见上面第 2 条）。
     dir 是视线方向，光从 -uBeamDir 来，所以「顺着光看」= dir·(−beamDir) > 0。 */
  float g = clamp(uPhaseG, 0.0, 0.95);
  float cosS = dot(dir, -uBeamDir);
  float denom = max(1.0 + g * g - 2.0 * g * cosS, 1e-4);
  float phase = (1.0 - g * g) / (denom * sqrt(denom));
  /* 完整 HG 的前后比在 g=0.6 时高达几十比一，那是「亮包」，而且「顺着光看」
     正好是抬头看 Snell 窗的方向、也就是**正文带**。所以先夹住上限，再只取
     一小部分强度：留下的是一层方向感，不是一个光源。 */
  const float PHASE_STRENGTH = 0.25;
  float dirW = mix(1.0, clamp(phase, 0.0, 3.0), PHASE_STRENGTH);

  for (int i = 0; i < STEPS; i++) {
    if (t >= limit) break;
    ds = min(ds, limit - t);
    vec3 p = vec3(0.0, -uDepth, 0.0) + dir * (t + ds * 0.5);
    if (p.y > 0.0) break;

    // 这一点到水面（沿漫射参考方向）的距离，也就是天光在水里走过的那一段
    float ambLen = p.y / uAmbDir.y;

    // 积分权重只有两项：视线方向上的消光 exp(-aRef·t)（把积分限制在相机
    // 周围 SCAT_LEN 米之内），以及天光从水面走到 p 点的消光 exp(-uAbsorb·ambLen)。
    sumAmb += exp(-uAbsorb * ambLen) * exp(-aRef * t) * ds;

    t += ds;
    ds *= STEP_GROWTH;
  }

  marched = t;
  return uScatterTint * (sumAmb * aRef) * uAmbPower * uScatterNorm * dirW;
}

/**
 * 带导数淡出的噪声（clearwater 用 textureGrad + 多尺度混合做同一件事，
 * 程序化噪声这边对应的就是按 fwidth 退回均值）。
 *
 * 为什么必须有：画面下半幅的沙离相机只有两三米，一纹素跨几十厘米 ——
 * 高频那几档格子在那里连一个完整周期都放不下。直接采样的话，低渲染分辨率下
 * 它不是「细节」而是走样：磁贴栏那一带会浮一层摩尔纹，而且随波纹每帧闪。
 * 所以每一档先问自己「一个像素还剩几个可分辨的周期」，不到一个就退回均值。
 */
float nzFade(vec2 p, float scale) {
  float cell = 1.0 / max(scale, 1e-5);
  float px = fwidth(p.x) + fwidth(p.y);
  return mix(0.5, vnoise(p * scale), smoothstep(1.2, 3.0, cell / max(px, 1e-5)));
}

/**
 * 海底。它同时解决两个问题：构图上，画面有了一个「地平」，不再是无方向的渐变；
 * 可读性上，往下看是**被光照亮的沙**，而不是一个会把自动曝光拖垮的黑洞 ——
 * 浅水主题要的高亮度，物理上就是白沙把光弹回来。
 *
 * 沙面上那层晃动的光网和头顶的水面是同一个图案：这里用的是同一张光网，
 * 只是把点换成沙面上的点 —— 沙面上被照亮的地方，正是头顶水面上
 * 那条亮线沿光的方向投下来的地方。
 *
 * 底面之所以读得出来，靠的是四件事（缺一件它就会退化成一块没有纹理的色阶）：
 *
 *   1. **伪高度**（`hgt`）：底面有起伏，于是同一束光下有明暗、有影子；
 *   2. **分区底质**（`coarse` / `sandM`）：粗砂砾和细沙不是同一种反照率，
 *      而且高度决定材质，不是噪声直接决定颜色；
 *   3. **接触阴影**（`ao`）：低洼处本来就照不到几束光，乘一个高度的函数；
 *   4. **焦散跟着地形走**（取样点 `q` 沿光向偏移 `hgt`）：亮线打在凸起的脊上、
 *      凹处被自己挡住 —— 这一步让光网从「贴在沙上的一层花纹」变成「扫过地形的东西」。
 *
 * 涟漪波痕（`marks`）和海藻（`weed`）也是它的底面构成，两者都只改反照率不改几何。
 */
vec3 seaFloor(vec3 p, vec3 dir, float dist, float alive) {
  // 沙丘：低频起伏只影响明暗，不改几何（不值得为此多做一次求交）
  float dune = clamp(fbm(p.xz * 0.012 + 31.0, 3) * 1.7 + 0.15, 0.0, 1.0);

  /* 伪高度：中频沙丘 + 高频波痕。
     它不是真的几何 —— 求交仍然打在平面上 —— 而是「同一束光下哪里该亮哪里该暗」。
     波痕用 sin(坐标·方向 + 噪声扰动)，方向被噪声掰弯，才是水冲出来的样子而不是栅格。

     全部走 nzFade：低渲染分辨率下直接采样高频不是细节，是走样
     （磁贴栏那一带会浮一层摩尔纹，还随波纹每帧闪）。 */
  float markPhase = dot(p.xz, vec2(0.93, 0.37)) * 16.0 + 3.0 * nzFade(p.xz, 0.8);
  // 波痕本身有固定周期：一个像素跨过半档就没有意义，按导数淡出
  float markFade = smoothstep(0.6, 2.4, 1.0 / max(fwidth(p.x) + fwidth(p.z), 1e-5) / 16.0);
  float marks = 0.5 + 0.5 * sin(markPhase) * markFade;
  float hgt = clamp(0.55 * dune + 0.30 * (nzFade(p.xz, 2.5) - 0.5) * 2.0 + 0.18 * marks, 0.0, 1.0);
  /* 分区底质：粗砂砾占一片、细沙先填进低洼处（`sandM` 用高度做阈值 ——
     这就是「沙填谷」，也是底面读得出地形的另一半原因）。 */
  float coarse = smoothstep(0.42, 0.62, nzFade(p.xz * 0.21 + 40.0, 1.0));
  float sandM = smoothstep(hgt + 0.02, hgt + 0.16, (nzFade(p.xz * 0.16 + 3.0, 1.0) - 0.46) * 1.6);
  // 大尺度变化：晒白的浅斑、发暗的水草洼（只动反照率）
  float big = nzFade(p.xz, 0.45) * 0.65 + nzFade(p.xz, 1.3) * 0.35;
  float weed = smoothstep(0.55, 0.85, nzFade(p.xz, 0.32));

  /* 反照率：白沙为基准，粗砂砾压暗一点、水草洼偏橄榄，晒白斑抬亮。

     调制范围刻意放得比「想要更多纹理」更大，这是**肩部逼出来的**：沙面的场景值
     落在 ACES 的肩部附近，那里斜率很低 —— 小幅度的反照率调制到屏幕上只剩几个百分点，
     正好是「看不出有东西」的那一档。放宽之后均值几乎不变，所以自动曝光闭环和薄膜
     的整套校准不受影响，变的只是**局部对比**。低半边比高半边拉得更开：
     暗的那一侧落在 ACES 的线性段里，亮的那一侧顶到肩部也只是少给亮 ——
     把预算花在暗部，是这一层唯一有效的方向。 */
  vec3 alb = SAND * mix(0.58, 1.22, big);
  alb = mix(alb, alb * vec3(0.72, 0.70, 0.62), coarse * (1.0 - sandM));
  alb = mix(alb, alb * vec3(0.48, 0.58, 0.38), weed * 0.65 * (1.0 - sandM));
  // 波痕的明暗（细沙上才看得见，粗砂砾上被颗粒噪声盖过）
  alb *= 1.0 - 0.12 * (1.0 - marks) * sandM;

  float beamLen = p.y / uBeamDir.y;
  vec3 beamTrans = exp(-uAbsorb * beamLen);
  /* 焦散的取样点：沿光的来向投影回水面，再按伪高度推一下 ——
     凸起 (hgt 大) 的取样点朝光的方向挪，凹陷的往后挪，于是亮线「爬」在地形上。
     这一条和 ao 一起，是光网从花纹变成扫过地面的关键。 */
  vec2 q = p.xz - uBeamDir.xz * beamLen
    + uBeamDir.xz / max(-uBeamDir.y, 1e-3) * (hgt - 0.5) * 0.05;
  // 光网强度按活度收缩幅度、守均值（见 waterVolume 里那条守均值的注释）
  float net = uCaustic * (1.0 + (fineNet(q) - 1.0) * alive);
  // 点击涟漪同样打在沙上（沙面上的环比水面上的环更好读，因为它是亮线本身）
  vec3 drop = dropField(q);
  net *= clamp(1.0 + DROP_CAUSTIC * drop.z, 0.3, 2.5);

  // 接触阴影：低洼处收不到几束光（clearwater 的 ao，阈值按我们的 hgt 分布定）
  float ao = mix(0.55, 1.0, smoothstep(0.15, 0.60, hgt));

  vec3 lit = uBeamTint * beamTrans * (net * NET_GAIN) * uBeamPower * ao;
  // 沙面的环境光只留一点点。沙之所以亮，是因为光网打在它身上（上面那一项），
  // 不是因为水自己会发光；这项给多了，沙面上那些亮线就浮不出来了。
  // 同样要按走过的水路做光谱衰减，否则它会以「相机深度那一层的颜色」糊在沙上，
  // 把沙面染成一层不受深度影响的灰青。
  float ambLen = p.y / uAmbDir.y;
  lit += uScatterTint * 0.25 * uAmbPower * exp(-uAbsorb * ambLen) * mix(0.7, 1.0, ao);
  lit *= 0.74 + 0.52 * dune;

  // 掠射时按兰伯特变暗。下限不能太低：压过头画面最下面那一条（最近、最该是一片
  // 亮沙的地方）会变成暗青色，整幅画的「地平」就塌了。
  lit *= clamp(-dir.y * 1.9, 0.66, 1.0);
  return lit * alb;
}

/**
 * 水面本身，以及透过 Snell 窗看到的水面之上。视线穿出水面的那一刻，
 * 剩下的透过率乘的就是它。
 *
 * 分成两种情况是这个函数存在的全部理由：窗**以内**看得见天（亮），窗外是全反射 ——
 * 水面成了一面镜子，映的是水里的暗。这道明暗分界不用画，它是折射率的直接结果，
 * 也是水下照片里那道「抬头才有的亮环」。
 */
vec3 surfaceAt(vec3 dir, vec3 p) {
  // 返回 vec3(∂h/∂x, ∂h/∂z, 全带焦散)：镜面那一侧看到的、以及水面下方那层晃动，
  // 都是同一张光网 —— 算一次就够
  vec3 surf = waveField(p.xz);
  // 点击涟漪：斜率是物理量、直接加；焦散走和 FFT 场同一条线性化公式
  vec3 drop = dropField(p.xz);
  vec2 slope = surf.xy + drop.xy;
  float surfNet = min(surf.z * clamp(1.0 + DROP_CAUSTIC * drop.z, 0.3, 2.5), NET_MAX);

  // 这一小块水面自己的朝向。有了它，Snell 窗的边界才是碎的。
  // 斜率直接来自 FFT 波场，是**物理斜率**（无量纲），不再乘任何艺术系数 ——
  // 解析波场的绝对幅度没有物理含义，而 FFT 的谱已按目标斜率均方根归一。
  vec3 n = normalize(vec3(-slope.x, 1.0, -slope.y));

  // 水 → 空气的折射方向自己算，两个原因：
  //
  // 一是 GLSL 的 refract(I, N, eta) 要求 N 与 I **反向**（dot(N,I) < 0）。
  // 这里 dir 朝上、法线也朝上，直接把两者喂进去算出来的是废数：它的法向分量
  // 恒等于 -cosθt ≤ 0，也就是折射光线永远朝下。于是 o.y 被 clamp 到 0，
  // 窗内亮度成了一个**常数** —— 太阳、月亮也全都对不上。
  // 「Snell 窗是一块没有信息的纯色」真正的原因在这里，不在调色上。
  // N 取 -n 之后的标准式是 t = eta·I - (eta·cosθi - cosθt)·n。
  //
  // 二是要它**在临界角附近连续**：refract() 在全反射时返回 0，而窗沿需要的是
  // 一个渐变，所以把 cosθt 截断到 0 一直算下去，越界那部分由 Fresnel 权重压掉。
  float ci = clamp(dot(dir, n), 0.0, 1.0);
  float st = N_WATER * sqrt(max(1.0 - ci * ci, 0.0));   // 折射定律：sinθt = n·sinθi
  float ct = sqrt(max(1.0 - st * st, 0.0));
  vec3 o = normalize(N_WATER * dir - (N_WATER * ci - ct) * n);

  // 水面那道「边」不能用 refract() 返回不返回 0 来判 —— 那是一个硬 if，
  // 出来的边界是一刀切的折线，边缘还有锯齿。全反射是个非此即彼的判据，
  // 而真实水面的反射率是**连续**爬上去的。
  // 用菲涅耳反射率之后：垂直入射时几乎全透（窗心通透明亮），
  // 掠入射时几乎全反（窗沿镶一圈亮边），窗与镜之间自动是渐变的，一个 if 都不需要。
  float rs = (N_WATER * ci - ct) / max(N_WATER * ci + ct, 1e-4);
  float rp = (ci - N_WATER * ct) / max(ci + N_WATER * ct, 1e-4);
  float mirrorW = st >= 1.0 ? 1.0 : clamp(0.5 * (rs * rs + rp * rp), 0.0, 1.0);

  // 窗内：把视线折射出水，看水面之上的天。
  // 注意 o 是**随波抖动**的 —— 整片天光因此在窗内游动，太阳的圆面也会闪，
  // 这就是水下抬头看到的碎金。它不是加了一层噪声，是折射本身。
  //
  // 再乘一层 surfNet：天本身是均匀的，但**穿过波面的光通量不均匀** ——
  // 凹下去的波面像透镜一样把天光挤成亮线。这就是抬头看到的窗上那层网。
  // 少了它，窗内就是一块纯色：占着画幅三分之一却什么信息都没有。
  //
  // 最后一项是出射角的衰减，它答的是「中段为什么发白」：
  // 上一版从掠射到正上方只差两倍多，于是**倒影带里漏出来的天光**和窗中心一样亮。
  // 而倒影带本来就该全反射 —— 漏光来自那些恰好把法线转平、入射角掉回临界角
  // 以下的波纹面；它们折射出去的方向都在掠射区，旧曲线却给了很高的系数，
  // 场景值直接顶进 ACES 肩部变成纯白 —— 全画幅看着像冰面，就是这些像素。
  // 物理上这也更对：掠射出射对应天空里极大的一块立体角，那里的辐亮度本来就低得多，
  // 而且光在贴近水面的那段路上还要多走一截。
  vec3 col = uSkyAbove * (0.14 + 1.30 * pow(clamp(o.y, 0.0, 1.0), 4.0)) * (0.55 + 0.45 * surfNet);

  /* 太阳的像：**不能按点光源画** —— 和下面月亮那条是同一条规矩。
     水面法线的 RMS 由谱的归一化给出（见 ocean.ts 的 TARGET_SLOPE），
     出射方向 o 就是被这个抖动掰来掰去的。角宽度若远小于抖动，就只有那些
     法线恰好把视线掰到日面上的像素才亮，画面上是一把从太阳位置放射出去的细针 ——
     读起来像拉丝冰、云母、彗尾，不像水。

     物理上：**抖动宽度本身就是点扩散函数**，日面被它抹成一片柔光，没有可分辨的边。
     所以这里把宽度取成抖动本身，峰值相应压下来。
     宽度是物理量（不是调的）；峰值是艺术选择 —— 按通量守恒压下去太阳就彻底没了，
     取值目标是「一片柔和的亮斑，但不是纯白」。

     日面分三层：**色相 + 晕 + 碎**。
     1. **色相交给 uBeamTint。** 写死一个白会把「全画幅最该有的那处色相落差」抹掉：
        日落时水面上那轮金橙的太阳，透过窗看却是白的。CPU 侧的 keyTint 已经把
        「直射光本身的颜色」算好了（正午暖白、低太阳镀金、地平线深橙），用它就是白拿。
        峰值仍然往白里偏一点：日面中心是**饱和**的，色相只活在晕里 ——
        这是长时间曝光水下照片的共同读法。
     2. **一层宽晕**（HALO_GAIN / HALO_WIDTH），把窗从「均匀底色 + 一个点」
        变成「有中心的亮」。
     3. **日面被波纹撕碎**：把焦散场乘到核上。真实水下看太阳，看到的从来不是一枚
        圆面，是一串疯跳的亮节 —— 因为抖动本身就是 PSF，而 PSF 的强度在焦散线上
        被聚焦放大。用 surfNet（和沙面那张网同源）就是**免费且正确**的：
        日面的闪和水面的网是同一个物理场，不是叠了一层噪声。 */
  vec3 sunDir = normalize(uSunDir);
  float sunAng2 = 2.0 * (1.0 - clamp(dot(o, sunDir), -1.0, 1.0));
  float sunUp = smoothstep(0.0, 0.05, sunDir.y);
  vec3 sunTint = mix(uBeamTint, vec3(1.0), 0.35);
  float glitter = clamp(1.0 + (surfNet - 1.0) * GLITTER_CONTRAST, 0.15, GLITTER_MAX);
  col += sunTint * 0.30 * exp(-sunAng2 / (0.133 * 0.133)) * glitter * sunUp;
  col += uBeamTint * HALO_GAIN * exp(-sunAng2 / (HALO_WIDTH * HALO_WIDTH)) * sunUp;

  // 月亮同理，峰值一起压：按点画同样会碎成针。
  // 月晕比日晕宽一档、也亮一档：夜里窗整体暗，肩部的压缩没那么厉害，
  // 而「月亮在哪」这件事必须读得出来 —— 它是深色主题唯一的方位线索。
  vec3 moonDir = normalize(uMoonDir);
  float mang2 = 2.0 * (1.0 - clamp(dot(o, moonDir), -1.0, 1.0));
  vec3 moonTint = mix(uBeamTint, vec3(1.0), 0.30);
  col += moonTint * 0.10 * exp(-mang2 / (0.133 * 0.133)) * glitter
    * smoothstep(0.0, 0.06, moonDir.y);
  col += uBeamTint * 0.075 * exp(-mang2 / (0.62 * 0.62))
    * smoothstep(0.0, 0.06, moonDir.y);

  /* **星点倒影那一项已删除。**
   *
   * 它原本是一层按立体角抹平的常数微光。物理推导仍然成立：点光源在这个粗糙度下
   * 没有可分辨的像，只剩均匀的一层 —— 但它已经落到不可见的阈值之下，
   * 而它的整条上游在着色器里都没有别的消费者，删掉是**一次删一整条链**。
   * 夜里的镜面带由 uScatterTint 与月亮负责 —— 那两样才是深色主题真正读得出来的东西。 */

  // 窗外全反射：水面成了一面镜子，映的是它下方被光照亮的水。
  // 这是画面上半部**唯一**的结构来源 —— 一面平滑的镜子是看不到的，
  // 能看到的只有镜子里那张网，所以这张网必须和沙面上那张是同一张。
  //
  // 镜子里那片水的颜色不能直接用 uScatterTint：那是**相机所在深度**的水色。
  // 掠射视线在水面下映到的是更深处，光走过的路长得多，红色早被吃掉 ——
  // 直接拿相机那层的颜色当地板，整片镜子就是一层没有深度的淡薄荷色，
  // 画面的中段整个塌成一块平底。这里按 MIRROR_PATH 倍相机深度再做一次
  // 光谱衰减，镜子才落回它该有的深青色，画面也才有「上亮下暗」的纵向层次。
  vec3 mirrorTint = uScatterTint * exp(-uAbsorb * (uDepth * MIRROR_PATH));
  // 减去 1.0 再截断，是把「网的平均亮度」从镜子里拿掉。
  //
  // 焦散场的期望被标定成 1.0（初始化时回读实测，见 ocean.ts）—— 也就是说水面有一半面积在平均值以上。
  // 直接拿它当亮度用，等于给整片镜子垫了一层**常数**：测得中段 L 一直在 0.6~0.8，
  // 横向 R± 上百却看不出明暗，因为变化全发生在很亮的地方（ACES 肩部），
  // 画面上就只剩一片淡青加几道浅色斜纹，像拉丝金属。
  // 真实的倒影是「暗水里几根亮的焦散线」—— 只有被聚焦的那部分才看得见，
  // 于是这里只取均值以上的那一半，均值以下归零，暗处回到 mirrorTint 的深青。
  vec3 mirror = mirrorTint * MIRROR_BASE
    + uBeamTint * max(surfNet - 1.0, 0.0) * MIRROR_GLINT;
  col = mix(col, mirror, mirrorW);

  /* 窗沿那圈碎银（见 RING_GAIN）。加在 mix **之后**，因为它同时属于两边：
     它是交界本身，不是窗里的天，也不是镜里的水。
     乘 (0.6+0.4·surfNet) 让它跟着波纹碎 —— 均匀的一圈是「描边」，
     跟着焦散断掉的才是「银」。 */
  col += uSkyAbove * RING_GAIN * (4.0 * mirrorW * (1.0 - mirrorW))
    * (0.6 + 0.4 * surfNet);

  // 水面下方那层随波晃动的亮。低太阳时整面水都在反光，正午时它退成头顶一个亮斑。
  col += uBeamTint * uSurfaceGlow * min(surfNet, 2.0) * 0.35;
  return col;
}

/* ---------------- 合成 ---------------- */

/* ACES 曲线本来在这里。现在它在 tonemap.frag.glsl —— 因为要留在线性 HDR 上
   让泛光有东西可挑，色调映射必须挪到泛光**之后**。 */

void main() {
  vec3 dir = rayDir(gl_FragCoord.xy);
  vec3 eye = vec3(0.0, -uDepth, 0.0);

  /**
   * **活度 `alive`：水面波动只出现在顶部那一段，下缘抬到搜索栏以上。**
   *
   * 这是用户明确要的构图：「顶部的水面波动效果抬高，不要超过搜索栏」。
   *
   * 几何上这里有一条现成的分界：**地平线**。
   *   - 地平线以上（dir.y > 0）：视线穿出水面 → 见到 Snell 窗和波面，是「水面」；
   *   - 地平线以下：视线落在沙面 → 见到的是**沙面上的焦散网**。
   * 用户看到的「波动」一直铺到搜索栏以下，那段其实全是**沙面的光网**，不是水面。
   * 所以「把波动的下缘抬到搜索栏以上」= **把沙面光网在地平线附近收掉**。
   *
   * 之前那条曲线一直衰减到画面最底部，所以磁贴栏那一带还有一片看得见的光网。
   * 现在那里是沉静的水。
   *
   * **收缩幅度时一定守住均值**（见 waterVolume / seaFloor 里的注释）——
   * 焦散场是右偏的，减调制会把它整体抬亮，那样画面会一边变静一边变白。
   */
  float v = gl_FragCoord.y / uResolution.y;          // 0 = 画面底部，1 = 顶部
  float alive = smoothstep(0.68, 0.88, v);

  // 这条视线在水里能走多远。两个候选：穿出水面、撞上海底。谁近谁说了算。
  //
  // 海底那一步的符号是这幅画的关键：eye 在 y=-uDepth，沙在 eye 下方 uFloorDrop 米处，
  // 于是 t = (-uFloorDrop) / dir.y。dir.y<0 时它是正的。
  // 曾经写成 (uDepth - uFloorDepth)/dir.y —— 对每一条向下的视线都得到**负数**：
  // 体积积分的循环第一次就 break（marched=0），而 marched>=limit 反而成立，
  // 于是画面下半部分整个由「相机背后那个点上的海底」构成，透过率还大于 1 被放大。
  // 表现就是下半幅没有体积雾，只有一条和上半幅无关的暖色带。
  float surfaceDist = dir.y > 0.0 ? uDepth / dir.y : 1e9;
  float floorDist = uFloorDrop > 0.0 && dir.y < -1e-4 ? -uFloorDrop / dir.y : 1e9;
  float limit = min(surfaceDist, floorDist);

  float marched = 0.0;
  vec3 col = waterVolume(dir, limit, marched);

  // 体积积分只算了「水里散射进来的光」。视线终止的那个面上有什么，在这里补。
  // 注意 marched 可能小于 limit（步进预算走完了），此时剩下的透过率几乎为 0，补不到东西。
  if (marched >= limit && limit < 1e8) {
    vec3 through = exp(-uAbsorb * limit);
    vec3 p = eye + dir * limit;
    if (floorDist <= surfaceDist) col += through * seaFloor(p, dir, limit, alive);
    else col += through * surfaceAt(dir, p);
  }

  col *= uExposure * uGain;

  /* 输出**线性 HDR**，不做色调映射。
   *
   * 这一趟必须让亮部真的超过 1.0，UnrealBloomPass 才能靠阈值把它们挑出来单独
   * 去发光。如果在这里就 ACES 压进 [0,1]，泛光就退化成「把整幅画糊一遍」的模糊
   * —— 那不是辉光，那是没对上焦。
   *
   * ACES + sRGB 编码 + 抖动全部搬到 tonemap.frag.glsl 那个最终 pass。
   * 曝光仍然在这里乘：泛光的阈值因此跟着自动曝光一起动，夜里增益拉高时
   * 才会有更多东西开始发光，这在物理上是对的。 */
  outColor = vec4(max(col, 0.0), 1.0);
}
